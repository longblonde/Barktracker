[Unit]
Description=Barktracker bark detector and dashboard
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
SupplementaryGroups=audio
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@DIR@/.venv/bin/python -m barktracker -c @DIR@/config.yaml run
Restart=always
RestartSec=5
Nice=-5

[Install]
WantedBy=multi-user.target
